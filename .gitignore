# Deny by default: only reviewed website and maintenance files are tracked.
/*
!/.gitignore
!/.nojekyll
!/index.html
!/README.md
!/THIRD_PARTY_NOTICES.md
!/.publish-files.json
!/scripts/
/scripts/*
!/scripts/preview.py
!/scripts/sync_static.py
!/scripts/package_site.py
!/scripts/check_site.py
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/verify.yml
!/assets/
/assets/*
!/assets/css/
/assets/css/*
!/assets/css/style.css
!/assets/js/
/assets/js/*
!/assets/js/app.js
!/assets/js/content.js
!/assets/img/
/assets/img/*
!/assets/img/favicon.svg
!/assets/img/profile.jpg
!/assets/img/phd-research-overview.png
!/assets/img/hvac-ai-analyzer-dashboard.webp
!/assets/img/hvac-ai-analyzer-energy-analysis.webp
!/assets/img/hvac-ai-analyzer-diagnostics.webp

# Never publish private inputs, drafts, local tools or generated outputs.
/_private/
/.local/
/dist/
/.env
/.env.*
**/__pycache__/
**/*.pyc
**/node_modules/
*.pdf
*.pem
*.key
*.pfx
*.p12
*.db
*.sqlite
*.sqlite3
.DS_Store
Thumbs.db
